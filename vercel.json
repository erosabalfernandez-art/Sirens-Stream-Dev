{
  "installCommand": "npx --yes pnpm@9 install --no-frozen-lockfile --prod=false",
  "buildCommand": "cd artifacts/sirens-stream && BASE_PATH=/ npm run build",
  "outputDirectory": "artifacts/sirens-stream/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}